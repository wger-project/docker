# Copy this file to `.env` (in the same directory) and customize.
# Compose auto-loads it when run from `grafana/`. The `.env` file itself
# is gitignored.
#
#   cp .env.example .env

# --- Grafana admin login -----------------------------------------------------
# Username is "admin". Change the password before exposing publicly.
GRAFANA_ADMIN_PASSWORD=adminadmin

# --- Optional: Prometheus basic auth -----------------------------------------
# Only needed if you uncomment the web.yml mount in docker-compose.yml.
# Generate a matching bcrypt hash with `python gen-pass.py`.
#PROMETHEUS_ADMIN_PASSWORD=adminadmin

# --- Optional: mail for alert notifications ----------------------------------
# Alerts are sent to the address in provisioning/alerting/contactpoints.yml.
# The host includes the port, e.g. smtp.example.com:587
#GRAFANA_SMTP_ENABLED=true
#GRAFANA_SMTP_HOST=smtp.example.com:587
#GRAFANA_SMTP_USER=grafana@example.com
#GRAFANA_SMTP_PASSWORD=
#GRAFANA_SMTP_FROM_ADDRESS=grafana@example.com
