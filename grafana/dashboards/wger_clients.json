        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "count(sum by (client_ip) (count_over_time({container=~\".*(caddy|nginx).*\", request_host=~\"$host\"} | user_agent=~\"wger App/.*\" | regexp `wger App/(?P<app_version>\\S+) \\((?P<package>[^;]+); build: (?P<build>[^;]+); platform: (?P<platform>[^)]+)\\)` | platform=~\"$platform\" [$__range])))",
          "refId": "A",
          "queryType": "instant",
          "instant": true
        }
      ],
      "title": "Unique client IPs",
      "type": "stat"
    },
