{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Which clients talk to this server: wger app versions and platforms (Android, iOS, Linux/Flathub, ...) as well as self-hosted wger instances syncing data. Based on the User-Agent in the Caddy/nginx access logs in Loki.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Requests from the wger mobile/desktop app (User-Agent `wger App/...`).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "sum(rate({container=~\".*(caddy|nginx).*\", request_host=~\"$host\"} | user_agent=~\"wger App/.*\" | regexp `wger App/(?P<app_version>\\S+) \\((?P<package>[^;]+); build: (?P<build>[^;]+); platform: (?P<platform>[^)]+)\\)` | platform=~\"$platform\" [$__interval]))",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "title": "App requests / sec",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Share of all requests in the selected range that come from the app.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          },
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "100 * sum(count_over_time({container=~\".*(caddy|nginx).*\", request_host=~\"$host\"} | user_agent=~\"wger App/.*\" | regexp `wger App/(?P<app_version>\\S+) \\((?P<package>[^;]+); build: (?P<build>[^;]+); platform: (?P<platform>[^)]+)\\)` | platform=~\"$platform\" [$__range])) / sum(count_over_time({container=~\".*(caddy|nginx).*\", request_host=~\"$host\"} [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "instant": true
        }
      ],
      "title": "App share of all requests",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Distinct client IPs that used the app in the selected range. A rough proxy for devices: several devices can share one IP (NAT) and a mobile device changes IPs. Needs a raised `max_query_series` in Loki (see loki-config.yaml).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
