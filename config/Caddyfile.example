# The Caddyfile is an easy way to configure your Caddy web server.
#
# Unless the file starts with a global options block, the first
# uncommented line is always the address of your site.
#
# To use your own domain name (with automatic HTTPS), first make
# sure your domain's A/AAAA DNS records are properly pointed to
# this machine's public IP, then replace ":80" below with your
# domain name.

{
    servers {
        metrics
    }

    admin :2019

    # `include http.log.access` matches the access logger of every site
    #
    # Remove some of the headers, this baloons the size of the logs on a high-traffic server
    log access-json {
        include http.log.access
        output file /var/log/www/access.log {
            roll_size 50MiB
            roll_keep 4
            roll_keep_for 168h
        }
        format filter {
            wrap json
            fields {
                request>tls delete
                resp_headers delete
            }
        }
    }

    # Uncomment to also pipe access logs to stdout, e.g. so Alloy/Loki can pick
    # them up. This one is trimmed down to the fields the Grafana dashboards query
    #log access-stdout {
    #    include http.log.access
    #    format filter {
    #        wrap json
    #        fields {
    #            request>headers delete
    #            request>tls delete
    #            request>remote_ip delete
    #            request>remote_port delete
    #            resp_headers delete
    #            bytes_read delete
    #            user_id delete
    #            msg delete
    #        }
    #    }
    #}
}

#your.domain.example.com {
localhost {
    tls your@email.address
    log wger

    # Log the User-Agent as a top-level `user_agent` field, independent of the
    # `request>headers` block (which can be dropped from the log, see above).
    # The "wger Clients" Grafana dashboard reads the app version and platform
    # of the mobile clients from it.
    log_append user_agent {header.User-Agent}

    encode

    handle /static/* {
        root * /wger

        # Files processed by collectstatic have a content hash in their names
        # (e.g. main.1a2b3c4d5e6f.css), so they can be cached forever. Files
        # without one (e.g. assets loaded at runtime by JS bundles) can change
        # between releases, let browsers revalidate them
        @hashed path_regexp \.[0-9a-f]{12}\.[^./]+$
        @unhashed not path_regexp \.[0-9a-f]{12}\.[^./]+$
        header @hashed Cache-Control "public, max-age=31536000, immutable"
        header @unhashed Cache-Control "no-cache"
        file_server
    }

    handle /media/* {
        root * /wger
        file_server
   }

    # Reverse proxy for the PowerSync service, used by the mobile app for offline mode.
    #
    # The sync stream must not be buffered. Caddy flushes responses without a
    # Content-Length immediately and passes the upstream's X-Accel-Buffering
    # header on, so a proxy in front of Caddy gets that hint as well.
    handle_path /ps/* {
        reverse_proxy powersync:8080
    }

    # Catch-all: everything not matched above goes to the wger backend.
    # Replace with `reverse_proxy anubis:3000` if you are using Anubis.
    reverse_proxy web:8000 {
        # Retry failed connection attempts for a few seconds. This bridges the
        # short window during a rolling deployment where the old web container
        # is already gone but its IP might still be dialed.
        lb_try_duration 5s

        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {http.X-Forwarded-For} {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Http-Version {http.request.proto}
    }
}

# Refer to the Caddy docs for more information:
# https://caddyserver.com/docs/caddyfile